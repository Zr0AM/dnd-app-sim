{
	"name": "dnd-app-sim-worker",
	"description": "Cloudflare Worker fronting the sim-service container",
	"dependencies": {
		"hono": "4.11.1"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.1.3",
		"@vitest/runner": "4.1.10",
		"@vitest/snapshot": "4.1.10",
		"typescript": "5.9.3",
		"vitest": "4.1.10",
		"wrangler": "4.136.1"
	},
	"private": true,
	"scripts": {
		"cf-typegen": "wrangler types",
		"check": "tsc --noEmit && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"e2e:dev": "wrangler dev --enable-containers=false",
		"start": "wrangler dev",
		"test": "vitest run"
	},
	"type": "module"
}
